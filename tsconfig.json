{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    
    // "paths" below are tsconfig-relative, so no "baseUrl" is needed --
    // TypeScript 6 deprecates it and 7 removes it.
    "paths": {
      // Your existing alias
      "@/*": [
        "./*"
      ],
      // 2. ADD THIS LINE: The mapping for the remote Deno import
      "https://esm.sh/@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions"
  ]
}