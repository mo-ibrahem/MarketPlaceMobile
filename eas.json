{
  "cli": {
    "version": ">= 16.20.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_PAYMENTS_ENABLED": "false" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_PAYMENTS_ENABLED": "false" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_PAYMENTS_ENABLED": "false" }
    },
    "payments-preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_PAYMENTS_ENABLED": "true" }
    }
  },
  "submit": {
    "production": {}
  }
}
